*.tgz
charts/
.DS_Store
# Output of scripts/render-dify-values.sh - contains resolved live credentials.
dify-values.yaml
dify-values.local.yaml
# Anchored to the root and wildcarded: `dify-values.yaml` alone did not cover
# `dify-values.yaml_init`, which reached this public repo with live credentials.
/dify-values*
kubeconfig*

# Raw capture output is ignored ON PURPOSE.
#
# This repository is public. scripts/capture-deployment.sh redacts credentials,
# but raw cluster output is exactly the kind of thing that leaks something
# nobody thought about - an internal hostname, a token in an event message, a
# customer name in a log line.
#
# The workflow is: capture -> read -> write up conclusions in
# docs/deployment-findings.md -> commit that.
#
# To commit a specific captured file anyway, after reading it:
#   git add -f captured/<file>
captured/

# Offline delivery artifacts and customer registry credentials.
/offline-bundle*/
/offline-state*/
/customer*.yaml
/customer*.yml
auth.json
.dockerconfigjson
htpasswd
*.key
*.p12
*.pfx
.kube/
__pycache__/
*.pyc
.venv/
offline-venv/

# RHDP cluster bootstrap state: installer assets, logs and registry credentials.
/rhdp-state*/
/rhdp-bootstrap*/
install-config.yaml
install-config.backup.json
.openshift_install_state.json
registry-password
registry-auth.json
node-debug-key
node-debug-key.pub
/dify-bootstrap*/
/dify-state*/
local-s3.json
local-s3.env
deployment-ready.json

inventory.local.yml
*.local.yml
.ansible/
kubeadmin-password
