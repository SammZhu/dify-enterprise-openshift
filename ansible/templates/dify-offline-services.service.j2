# Managed by dify-enterprise-openshift Ansible
[Unit]
Description=Dify offline Registry, wheel index and S3 boot recovery
Wants=network-online.target
After=network-online.target
RequiresMountsFor={{ rhdp_settings.remoteDir }}/state {{ rhdp_settings.remoteDir }}/bundle
ConditionPathExists={{ rhdp_settings.remoteDir }}/bundle/images.lock.yaml
ConditionPathExists={{ rhdp_settings.remoteDir }}/state/auth.json
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
ExecStart=/usr/bin/podman --cgroup-manager=cgroupfs start dify-offline-s3 dify-offline-registry dify-offline-pypi
ExecStop=/usr/bin/podman --cgroup-manager=cgroupfs stop --ignore --time=30 dify-offline-pypi dify-offline-registry dify-offline-s3
TimeoutStartSec=180
TimeoutStopSec=120
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
